# ==============================================================================
# Lex.uz Legal RAG - Environment Configuration
# ==============================================================================

# Google Gemini API Key (получите бесплатный ключ на https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Модель Gemini (по умолчанию gemini-2.5-flash или gemini-1.5-flash)
LEXUZ_LLM_MODEL=gemini-2.5-flash

# Qdrant Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=lexuz_collection

# Web Server Configuration
LEXUZ_HOST=0.0.0.0
LEXUZ_PORT=8000

