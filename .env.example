# ==============================================================================
# Lex.uz Legal RAG - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Выбор провайдера: deepseek, openai, anthropic (claude), gemini, custom
# Если LLM_PROVIDER не указан, работает автоопределение по наличию API-ключей
# (приоритет: DEEPSEEK_API_KEY -> OPENAI_API_KEY -> ANTHROPIC_API_KEY -> GEMINI_API_KEY)
# ------------------------------------------------------------------------------
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# DeepSeek API (https://platform.deepseek.com) - Рекомендуется для Legal RAG
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI API (https://platform.openai.com)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Custom / Local LLM (OpenRouter, Groq, Ollama, Together, vLLM)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=your_key_if_needed

# ------------------------------------------------------------------------------
# Qdrant Vector Database Configuration
# ------------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=lexuz_collection

# ------------------------------------------------------------------------------
# Web Server Configuration
# ------------------------------------------------------------------------------
LEXUZ_HOST=0.0.0.0
LEXUZ_PORT=8000
